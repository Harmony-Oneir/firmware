# Прошивки устройств из linux-firmware (скачивается по linux-firmware.xml в linux-firmware/).
# Ставятся в /lib/firmware. Шаблон: device/qemu/common/virt_full/kernel/firmware.

import("//build/ohos.gni")

_fw = "linux-firmware"
_part = "oneir_firmware"
_subsystem = "oneir"

# Qualcomm Atheros QCA9377 (ath10k_pci)
ohos_prebuilt_etc("ath10k_qca9377_fw") {
  source = "$_fw/ath10k/QCA9377/hw1.0/firmware-6.bin"
  install_images = [ "system" ]
  module_install_dir = "lib/firmware/ath10k/QCA9377/hw1.0"
  part_name = _part
  subsystem_name = _subsystem
}

ohos_prebuilt_etc("ath10k_qca9377_board2") {
  source = "$_fw/ath10k/QCA9377/hw1.0/board-2.bin"
  install_images = [ "system" ]
  module_install_dir = "lib/firmware/ath10k/QCA9377/hw1.0"
  part_name = _part
  subsystem_name = _subsystem
}

ohos_prebuilt_etc("ath10k_qca9377_board") {
  source = "$_fw/ath10k/QCA9377/hw1.0/board.bin"
  install_images = [ "system" ]
  module_install_dir = "lib/firmware/ath10k/QCA9377/hw1.0"
  part_name = _part
  subsystem_name = _subsystem
}

# Ralink RT2870/RT3070 (rt2800usb): драйвер ищет файл в самом /lib/firmware
ohos_prebuilt_etc("rt2870_fw") {
  source = "$_fw/rt2870.bin"
  install_images = [ "system" ]
  module_install_dir = "lib/firmware"
  part_name = _part
  subsystem_name = _subsystem
}

group("oneir_firmware") {
  deps = [
    ":ath10k_qca9377_fw",
    ":ath10k_qca9377_board2",
    ":ath10k_qca9377_board",
    ":rt2870_fw",
  ]
}
