<?xml version="1.0" encoding="UTF-8"?>
<!-- Скачивает linux-firmware и wireless-regdb зафиксированных версий в oneir/firmware/.
     Подключается ссылкой из .repo/local_manifests (см. README). -->
<manifest>

  <!-- Прошивки устройств -->
  <remote name="kernel-firmware"
          fetch="https://git.kernel.org/pub/scm/linux/kernel/git/firmware/" />

  <project name="linux-firmware.git"
           path="oneir/firmware/linux-firmware"
           remote="kernel-firmware"
           revision="refs/tags/20250311"
           clone-depth="1" />

  <!-- База региональных правил Wi-Fi (regulatory.db) для cfg80211; встраивается в ядро -->
  <remote name="wireless-regdb"
          fetch="https://git.kernel.org/pub/scm/linux/kernel/git/wens/" />

  <project name="wireless-regdb.git"
           path="oneir/firmware/wireless-regdb"
           remote="wireless-regdb"
           revision="refs/tags/master-2026-09-03"
           clone-depth="1" />

</manifest>
